[Unit]
Description={{app_name}}
After=syslog.target

[Service]
User={{app_name}}
ExecStart=/usr/bin/java -jar /opt/{{app_name}}/bin/{{app_name}}.jar
WorkingDirectory=/opt/{{app_name}}/bin
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{app_name}}
SuccessExitStatus=143
EnvironmentFile=/opt/{{app_name}}/conf/prod.env

[Install]
WantedBy=multi-user.target
