<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="
                    http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
>
    <changeSet id="20260806_1200" author="TGL">

        <createSequence schemaName="radar_eventsaver" sequenceName="event_id_seq" startValue="1" incrementBy="1"/>

        <createTable schemaName="radar_eventsaver" tableName="event">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="timestamp" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="icao" type="varchar2(16)">
                <constraints nullable="false"/>
            </column>
            <column name="flight" type="varchar2(32)">
                <constraints nullable="true"/>
            </column>
            <column name="latitude" type="numeric(9,6)">
                <constraints nullable="true"/>
            </column>
            <column name="longitude" type="numeric(9,6)">
                <constraints nullable="true"/>
            </column>
            <column name="description" type="varchar2(64)">
                <constraints nullable="true"/>
            </column>
            <column name="alt_baro" type="varchar2(16)">
                <constraints nullable="true"/>
            </column>
            <column name="type" type="varchar2(32)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex tableName="event" indexName="event_timestamp_idx" schemaName="radar_eventsaver">
            <column name="timestamp"/>
        </createIndex>

        <createIndex tableName="event" indexName="event_icao_idx" schemaName="radar_eventsaver">
            <column name="icao"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>